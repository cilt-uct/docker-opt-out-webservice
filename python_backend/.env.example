# Non-secret connection details. Copy to .env and adjust for your environment.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=timetable
DB_USER=optout
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_ENABLED=false
COOKIE_SECURE=false

# External-service addresses are configuration, not passwords.
LDAP_HOST=ldaps://ldap.example.org
LDAP_PORT=636
LDAP_USER=service-account@example.org
LDAP_BASE_DN=dc=example,dc=org
LDAP_FILTER=(cn={username})
D2L_HOST=https://d2l.example.org
D2L_USER=service-account
VULA_HOST=https://vula.example.org
VULA_USER=service-account
OC_HOST=https://opencast.example.org
OC_USER=optout-service
